{
    "name": "uptime-kuma",
    "version": "3.0.0-beta.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/louislam/uptime-kuma.git"
    },
    "engines": {
        "node": ">= 26.2.0"
    },
    "scripts": {
        "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
        "lint:js-prod": "node --run lint:js",
        "lint-fix:js": "eslint --ext \".js,.vue\" --fix --ignore-path .gitignore .",
        "lint:style": "stylelint \"**/*.{vue,css,scss}\" --ignore-path .gitignore",
        "lint-fix:style": "stylelint \"**/*.{vue,css,scss}\" --fix --ignore-path .gitignore",
        "lint": "node --run lint:js && node --run lint:style",
        "fmt": "prettier --write \"**/*.{js,ts,vue,css,scss,json,md,yml,yaml}\"",
        "lint:prod": "node --run lint:js-prod && node --run lint:style",
        "build": "vite build",
        "vite-preview-dist": "vite preview --host",
        "dev": "cross-env NODE_ENV=development vite --host",
        "test": "node --import=tsx --import=./test/setup.ts --test \"test/frontend-test/**/*.ts\""
    },
    "dependencies": {
        "@better-auth/api-key": "~1.7.12",
        "@vvo/tzdb": "~6.198.0",
        "axios": "~0.34.0",
        "better-auth": "~1.7.12",
        "compare-versions": "~3.6.0",
        "country-flag-emoji-polyfill": "~0.1.8",
        "dayjs": "~1.11.19",
        "jsonata": "~2.2.2",
        "marked": "~14.1.4",
        "mitt": "~3.0.1",
        "tsx": "~4.23.1",
        "validator": "~13.15.26"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-svg-core": "~1.2.36",
        "@fortawesome/free-regular-svg-icons": "~5.15.4",
        "@fortawesome/free-solid-svg-icons": "~5.15.4",
        "@fortawesome/vue-fontawesome": "~3.1.3",
        "@popperjs/core": "~2.10.2",
        "@types/bootstrap": "~5.1.13",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "~8.71.2",
        "@typescript-eslint/parser": "~8.71.2",
        "@vitejs/plugin-vue": "~6.0.7",
        "@vue/compiler-sfc": "~3.5.39",
        "@vuepic/vue-datepicker": "~3.4.8",
        "bootstrap": "5.1.3",
        "chart.js": "~4.2.1",
        "chartjs-adapter-dayjs-4": "~1.0.4",
        "cronstrue": "~2.24.0",
        "cross-env": "~7.0.3",
        "dompurify": "~3.4.0",
        "eslint": "~8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "~46.4.6",
        "eslint-plugin-vue": "~8.7.1",
        "eslint-plugin-vue-scoped-css": "~2.7.2",
        "favico.js": "~0.3.10",
        "postcss-html": "~1.8.1",
        "postcss-rtlcss": "~5.7.1",
        "postcss-scss": "~4.0.9",
        "prettier": "^3.8.1",
        "prismjs": "~1.30.0",
        "qrcode": "~1.5.4",
        "rollup-plugin-visualizer": "~7.0.1",
        "sass": "^1.101.0",
        "stylelint": "^15.11.0",
        "stylelint-config-prettier": "^9.0.5",
        "stylelint-config-standard": "~25.0.0",
        "terser": "~5.15.1",
        "typescript": "~6.0.3",
        "v-pagination-3": "~0.1.7",
        "vite": "~8.1.2",
        "vite-plugin-compression": "^0.5.1",
        "vue": "~3.5.39",
        "vue-chartjs": "~5.2.0",
        "vue-contenteditable": "~3.0.4",
        "vue-i18n": "~11.4.16",
        "vue-image-crop-upload": "~3.0.3",
        "vue-multiselect": "~3.0.0",
        "vue-prism-editor": "~2.0.0-alpha.2",
        "vue-qrcode": "~1.0.1",
        "vue-router": "~4.2.5",
        "vue-toastification": "~2.0.0-rc.5",
        "vuedraggable": "~4.1.0",
        "whatwg-url": "~12.0.1"
    },
    "allowScripts": {
        "@fortawesome/fontawesome-common-types@0.2.36": true,
        "@fortawesome/fontawesome-svg-core@1.2.36": true,
        "@fortawesome/free-regular-svg-icons@5.15.4": true,
        "@fortawesome/free-solid-svg-icons@5.15.4": true,
        "core-js@2.6.12": true,
        "vue-demi@0.12.5": true,
        "esbuild@0.28.2": true,
        "@parcel/watcher@2.6.0": true
    }
