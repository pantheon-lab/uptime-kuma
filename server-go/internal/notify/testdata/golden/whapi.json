{
 "provider": "whapi",
 "variants": {
  "default": {
   "config": {
    "whapiAuthToken": "v-whapiAuthToken",
    "whapiRecipient": "v-whapiRecipient",
    "whapiApiUrl": "https://svc.example/whapiApiUrl",
    "type": "whapi"
   },
   "scenarios": {
    "down": {
     "msg": "[Example Site] [🔴 Down] connect ECONNREFUSED",
     "requests": [
      {
       "method": "POST",
       "url": "https://svc.example/whapiApiUrl/messages/text",
       "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer v-whapiAuthToken"
       },
       "body": "{\"to\":\"v-whapiRecipient\",\"body\":\"[Example Site] [🔴 Down] connect ECONNREFUSED\"}"
      }
     ],
     "error": null
    },
