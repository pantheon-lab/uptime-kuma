{
 "provider": "gorush",
 "variants": {
  "default": {
   "config": {
    "gorushDeviceToken": "v-gorushDeviceToken",
    "gorushPlatform": "v-gorushPlatform",
    "gorushTitle": "v-gorushTitle",
    "gorushPriority": "v-gorushPriority",
    "gorushRetry": "v-gorushRetry",
    "gorushTopic": "v-gorushTopic",
    "gorushServerURL": "https://svc.example/gorushServerURL",
    "type": "gorush"
   },
   "scenarios": {
    "down": {
     "msg": "[Example Site] [🔴 Down] connect ECONNREFUSED",
     "requests": [
      {
       "method": "POST",
       "url": "https://svc.example/gorushServerURL/api/push",
       "headers": {
        "Content-Type": "application/json"
       },
       "body": "{\"notifications\":[{\"tokens\":[\"v-gorushDeviceToken\"],\"message\":\"[Example Site] [🔴 Down] connect ECONNREFUSED\",\"title\":\"v-gorushTitle\",\"priority\":\"v-gorushPriority\",\"retry\":0,\"topic\":\"v-gorushTopic\"}]}"
      }
     ],
     "error": null
    },
    "up": {
