{
 "provider": "HomeAssistant",
 "variants": {
  "default": {
   "config": {
    "longLivedAccessToken": "v-longLivedAccessToken",
    "homeAssistantUrl": "https://svc.example/homeAssistantUrl",
    "type": "HomeAssistant"
   },
   "scenarios": {
    "down": {
     "msg": "[Example Site] [🔴 Down] connect ECONNREFUSED",
     "requests": [
      {
       "method": "POST",
       "url": "https://svc.example/homeAssistantUrl/api/services/notify/notify",
       "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer v-longLivedAccessToken"
       },
       "body": "{\"title\":\"Uptime Kuma\",\"message\":\"[Example Site] [🔴 Down] connect ECONNREFUSED\",\"data\":{\"name\":\"Example Site\",\"status\":0,\"channel\":\"Uptime Kuma\",\"icon_url\":\"https://github.com/louislam/uptime-kuma/blob/master/public/icon.png?raw=true\"}}"
      }
     ],
     "error": null
    },
    "up": {
