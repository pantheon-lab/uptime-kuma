      {
       "method": "POST",
       "url": "https://chat-api.one.th/message/api/v1/push_message",
       "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer v-accessToken"
       },
       "body": "{\"to\":\"v-recieverId\",\"bot_id\":\"v-botId\",\"type\":\"text\",\"message\":\"UptimeKuma Alert:\\n[🔴 Down]\\nName: Example Site\\nconnect ECONNREFUSED\\nTime (Asia/Hong_Kong): 2026-01-02 11:04:05\"}"
      }
     ],
