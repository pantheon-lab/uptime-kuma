{
 "provider": "OneChat",
 "variants": {
  "default": {
   "config": {
    "accessToken": "v-accessToken",
    "recieverId": "v-recieverId",
    "botId": "v-botId",
    "type": "OneChat"
   },
   "scenarios": {
    "down": {
     "msg": "[Example Site] [🔴 Down] connect ECONNREFUSED",
