{
 "provider": "SevenIO",
 "variants": {
  "default": {
   "config": {
    "sevenioReceiver": "v-sevenioReceiver",
    "sevenioSender": "v-sevenioSender",
    "sevenioApiKey": "v-sevenioApiKey",
    "type": "SevenIO"
   },
   "scenarios": {
    "down": {
     "msg": "[Example Site] [🔴 Down] connect ECONNREFUSED",
     "requests": [
      {
       "method": "POST",
       "url": "https://gateway.seven.io/api/sms",
       "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "v-sevenioApiKey"
       },
       "body": "{\"to\":\"v-sevenioReceiver\",\"from\":\"v-sevenioSender\",\"text\":\"Your service Example Site (https://site.example/health) went down at 2026-01-02 11:04:05 (Asia/Hong_Kong). Error: connect ECONNREFUSED\"}"
      }
     ],
     "error": null
    },
    "up": {
     "msg": "[Example Site] [✅ Up] 200 - OK",
     "requests": [
      {
       "method": "POST",
       "url": "https://gateway.seven.io/api/sms",
       "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "v-sevenioApiKey"
       },
       "body": "{\"to\":\"v-sevenioReceiver\",\"from\":\"v-sevenioSender\",\"text\":\"Your service Example Site (https://site.example/health) went back up at 2026-01-02 11:04:05 (Asia/Hong_Kong).\"}"
      }
     ],
     "error": null
    },
