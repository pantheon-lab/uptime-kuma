  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Scope": {
        "type": "string",
        "enum": [
          "monitors:read",
          "monitors:write",
          "beats:read",
          "beats:write"
        ]
      },
      "MonitorInput": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "type": {
            "type": "string",
            "enum": [
              "http",
              "keyword",
              "port",
              "group"
            ]
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "interval": {
            "type": "integer",
            "minimum": 1,
            "default": 60,
            "description": "Seconds"
          },
          "retryInterval": {
            "type": "integer",
            "default": 0,
            "description": "Seconds, 0 uses interval"
          },
          "timeout": {
            "type": "number",
            "default": 0,
            "description": "Seconds, 0 is 80% of interval"
          },
          "maxRetries": {
            "type": "integer",
            "default": 0
          },
          "upsideDown": {
            "type": "boolean",
            "default": false
          },
          "parentId": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The group this monitor belongs to"
          },
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "default": "GET"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "type": "string"
          },
          "bodyEncoding": {
            "type": "string",
            "enum": [
              "json",
              "form",
              "xml"
            ],
            "default": "json"
          },
          "acceptedStatusCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "200-299"
            ]
          },
          "maxRedirects": {
            "type": "integer",
            "default": 10
          },
          "ignoreTls": {
            "type": "boolean",
            "default": false
          },
          "keyword": {
            "type": "string"
          },
          "invertKeyword": {
            "type": "boolean",
            "default": false
          },
          "hostname": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "propagateTrace": {
            "type": "boolean",
            "default": false,
            "description": "Send a W3C traceparent header to the target"
          }
        }
      },
      "Monitor": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MonitorInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              }
            },
            "required": [
              "id"
            ]
          }
        ]
      },
      "Beat": {
        "type": "object",
        "properties": {
          "monitorId": {
            "type": "integer"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "description": "0 down, 1 up, 2 pending, 3 maintenance"
          },
          "ping": {
            "type": [
              "number",
              "null"
            ]
          },
          "msg": {
            "type": "string"
          },
          "important": {
            "type": "boolean"
          },
          "duration": {
            "type": "integer"
          },
          "retries": {
            "type": "integer"
          },
          "traceId": {
            "type": "string",
            "description": "On failed beats"
          }
        }
      },
      "APIKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string",
            "description": "Identifies the key"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scope"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Updated at most once a minute"
          }
        }
      }
    }
  }
}