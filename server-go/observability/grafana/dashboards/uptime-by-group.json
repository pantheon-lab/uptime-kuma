    {
      "id": 9,
      "type": "table",
      "title": "Monitors",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT g.group_name AS \"Group\", g.monitor_name AS \"Monitor\",\nCASE l.status WHEN 1 THEN 'Up' WHEN 0 THEN 'Down' WHEN 2 THEN 'Pending' WHEN 3 THEN 'Maintenance' ELSE 'No data' END AS \"Status\",\nsum(h.up)::float8 / NULLIF(sum(h.up + h.down), 0) AS \"Uptime\", sum(h.ping_sum) / NULLIF(sum(h.ping_count), 0) AS \"Avg response\"\nFROM monitor_group_member g\nLEFT JOIN uptime_hourly h ON h.monitor_id = g.monitor_id AND $__timeFilter(h.bucket)\nLEFT JOIN LATERAL (SELECT status FROM heartbeat b WHERE b.monitor_id = g.monitor_id ORDER BY b.time DESC LIMIT 1) l ON true\nWHERE g.group_name IN ($group) GROUP BY 1, 2, 3 ORDER BY 4 ASC NULLS LAST",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.99
                    },
                    {
                      "color": "green",
                      "value": 0.999
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
