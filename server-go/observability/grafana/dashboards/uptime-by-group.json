          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT h.bucket AS time, g.group_name AS metric, sum(h.down) AS failed\nFROM uptime_hourly h JOIN monitor_group_member g USING (monitor_id)\nWHERE $__timeFilter(h.bucket) AND g.group_name IN ($group) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code"
        }
