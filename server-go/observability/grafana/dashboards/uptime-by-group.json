{
  "uid": "kuma-uptime-by-group",
  "title": "Uptime by group",
  "tags": [
    "uptime-kuma"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Overall uptime",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(h.up)::float8 / NULLIF(sum(h.up + h.down), 0) AS uptime FROM uptime_hourly h WHERE $__timeFilter(h.bucket) AND h.monitor_id IN (SELECT monitor_id FROM monitor_group_member WHERE group_name IN ($group))",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Share of successful checks across the selected groups, in the selected time range. Pending counts as failed, and maintenance is excluded."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Monitors",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT monitor_id) FROM monitor_group_member WHERE group_name IN ($group)",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed checks",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(h.down), 0) AS failed FROM uptime_hourly h WHERE $__timeFilter(h.bucket) AND h.monitor_id IN (SELECT monitor_id FROM monitor_group_member WHERE group_name IN ($group))",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Monitors down now",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM (SELECT DISTINCT monitor_id FROM monitor_group_member WHERE group_name IN ($group)) g\nJOIN monitor m ON m.id = g.monitor_id AND m.active\nCROSS JOIN LATERAL (SELECT status FROM heartbeat b WHERE b.monitor_id = g.monitor_id ORDER BY b.time DESC LIMIT 1) l WHERE l.status = 0",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Uptime by group",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT g.group_name AS \"Group\", count(DISTINCT g.monitor_id) AS \"Monitors\",\nSUM(h.up) FILTER (WHERE h.bucket >= now() - INTERVAL '24 hours')::float8 / NULLIF(SUM(h.up + h.down) FILTER (WHERE h.bucket >= now() - INTERVAL '24 hours'), 0) AS \"24 hours\", SUM(h.up) FILTER (WHERE h.bucket >= now() - INTERVAL '7 days')::float8 / NULLIF(SUM(h.up + h.down) FILTER (WHERE h.bucket >= now() - INTERVAL '7 days'), 0) AS \"7 days\", SUM(h.up) FILTER (WHERE h.bucket >= now() - INTERVAL '30 days')::float8 / NULLIF(SUM(h.up + h.down) FILTER (WHERE h.bucket >= now() - INTERVAL '30 days'), 0) AS \"30 days\",\nsum(h.down) FILTER (WHERE h.bucket >= now() - INTERVAL '24 hours') AS \"Failed checks (24h)\"\nFROM monitor_group_member g LEFT JOIN uptime_hourly h ON h.monitor_id = g.monitor_id AND h.bucket >= now() - INTERVAL '30 days'\nWHERE g.group_name IN ($group) GROUP BY g.group_name ORDER BY 3 ASC NULLS LAST",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "24 hours"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.99
                    },
                    {
                      "color": "green",
                      "value": 0.999
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "7 days"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.99
                    },
                    {
                      "color": "green",
                      "value": 0.999
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "30 days"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.99
                    },
                    {
                      "color": "green",
                      "value": 0.999
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Uptime over time, by group",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT h.bucket AS time, g.group_name AS metric, sum(h.up)::float8 / NULLIF(sum(h.up + h.down), 0) AS uptime\nFROM uptime_hourly h JOIN monitor_group_member g USING (monitor_id)\nWHERE $__timeFilter(h.bucket) AND g.group_name IN ($group) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Average response time, by group",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT h.bucket AS time, g.group_name AS metric, sum(h.ping_sum) / NULLIF(sum(h.ping_count), 0) AS ping\nFROM uptime_hourly h JOIN monitor_group_member g USING (monitor_id)\nWHERE $__timeFilter(h.bucket) AND g.group_name IN ($group) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {}
    },
